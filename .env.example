# =============================
# ENTORNO: Desarrollo (local)
# =============================
# En desarrollo el proxy de Vite redirige /api a la API local (ver vite.config.ts),
# así que esta variable no es estrictamente necesaria, pero se puede sobrescribir.
VITE_API_BASE_URL=http://localhost:8000/api

# =============================
# ENTORNO: Producción (Render)
# =============================
# API backend desplegado en Render.
# VITE_API_BASE_URL=https://sistema-constancias-backend.onrender.com/api

# =============================
# ENTORNO: Demo (Railway)
# =============================
# VITE_API_BASE_URL=https://tu-app.up.railway.app/api

# =============================
# Vercel: variable PRIVADA (Config)
# =============================
# En Vercel, la URL de la API es segura exponerla, pero como Vercel muestra un
# aviso por variables con prefijo público (VITE_), configúrala como **Config**
# (privada) en el dashboard: Settings -> Environment Variables -> New Variable
# con Name = VITE_API_BASE_URL y Type = Config (encrypted, no expuesta al navegador).
# Vercel la inyecta en el entorno de build; el código la lee igual.
# Valor recomendado:
#   VITE_API_BASE_URL=https://sistema-constancias-backend.onrender.com/api